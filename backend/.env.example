# Environment Variables Template
# 
# DO NOT EDIT THIS FILE DIRECTLY
# This is just a template showing available environment variables
#
# For local development, use: .env.local
# For production, use: .env.production
#

# MongoDB Connection
# Local: mongodb://localhost:27017/salestracker
# Production: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGODB_URI=mongodb://localhost:27017/salestracker

# JWT Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=3000

# Node Environment (development or production)
NODE_ENV=development

# Frontend URL (optional, for CORS)
FRONTEND_URL=http://localhost:5000

# Email Configuration (Gmail)
# Use Gmail App Password, not regular password
# Generate App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

